    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@types/node": "^26.5.1",
    "sass": "^1.104.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-svgo": "^3.0.2",
    "vitest": "^5.0.3"
  }
}
