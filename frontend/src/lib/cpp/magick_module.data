  <configure name="DEFS" value="-DHAVE_CONFIG_H"/>
  <configure name="DELEGATES" value="ps"/>
  <configure name="DISTCHECK_CONFIG_FLAGS" value="'CC=/c/raylib/emsdk/upstream/emscripten/emcc' 'CXX=/c/raylib/emsdk/upstream/emscripten/em++'  --disable-deprecated  --with-quantum-depth=16  --with-jemalloc=no  --with-umem=no  --with-bzlib=no  --with-zlib=no  --with-autotrace=no  --with-dps=no  --with-fftw=no  --with-flif=no  --with-fpx=no  --with-fontconfig=no  --with-freetype=no  --with-gslib=no  --with-jpeg=no  --with-lcms=no  --with-openexr=no  --with-pango=no  --with-png=no  --with-rsvg=no  --with-tiff=no  --with-uhdr=no  --with-webp=no  --with-wmf=no  --with-perl=no "/>
  <configure name="DOCUMENTATION_PATH" value="/mingw64/share/doc/ImageMagick-7"/>
  <configure name="EXEC-PREFIX" value="/mingw64"/>
  <configure name="EXECUTABLE_PATH" value="/mingw64/bin"/>
  <configure name="FEATURES" value="Channel-masks(32-bit) Cipher DPC HDRI"/>
  <configure name="FILTER_PATH" value="/mingw64/lib/ImageMagick-7.1.2/modules-Q16HDRI/filters"/>
  <configure name="GIT_REVISION" value="f5f1a8233:20261005" />
  <configure name="HOST" value="x86_64-w64-mingw32"/>
  <configure name="INCLUDE_PATH" value="/mingw64/include/ImageMagick-7"/>
  <configure name="LDFLAGS" value="-L/mingw64/lib "/>
  <configure name="LIBRARY_ABSOLUTE_PATH" value="/mingw64/lib/ImageMagick-7.1.2"/>
  <configure name="LIBS" value="                                         -lm        "/>
  <configure name="LIB_VERSION_NUMBER" value="7,1,2,33"/>
  <configure name="LIB_VERSION" value="0x712"/>
  <configure name="NAME" value="ImageMagick"/>
  <configure name="PCFLAGS" value="-DMAGICKCORE_HDRI_ENABLE=1 -DMAGICKCORE_QUANTUM_DEPTH=16 -D_LIB -DMAGICKCORE_CHANNEL_MASK_DEPTH=32"/>
  <configure name="PREFIX" value="/mingw64"/>
  <configure name="QuantumDepth" value="16"/>
  <configure name="RELEASE_DATE" value="2026-10-05"/>
